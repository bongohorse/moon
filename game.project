[project]
title = MOON
version = 0.1.0
[native_extension]
app_manifest = /main/box2d3.appmanifest
[bootstrap]
main_collection = /main/main.collectionc
render = /main/moon.renderc
[display]
width = 1280
height = 720
high_dpi = 0
vsync = 1
[engine]
fixed_update_frequency = 60
max_time_step = 0.05
[physics]
type = 2D
scale = 0.01
gravity_y = -480
use_fixed_timestep = 1
max_collision_object_count = 128
[input]
game_binding = /main/input.input_bindingc
[android]
package = com.bongohorse.moon
version_code = 1
[html5]
htmlfile = /main/index.html
scale_mode = stretch
[collection]
max_instances = 256
[script]
shared_state = 1
