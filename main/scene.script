local state=require 'modules.state'
local vehicle=require 'modules.vehicle'
local terrain=require 'modules.terrain'
local input=require 'modules.input'
local camera=require 'modules.camera'
local config=require 'modules.config'
local art=require 'modules.art'
local function decor(pos,size,color)
    local id=factory.create('#pixel',pos,nil,nil,vmath.vector3(size.x/8,size.y/8,1))
    go.set(msg.url(nil,id,'sprite'),'tint',color)
    return id
end
local function restart(self)
    if self.vehicle then vehicle.destroy(self.vehicle) end
    state.settings=config.copy(state.pending); state.dirty=false
    self.vehicle=vehicle.create(state.settings)
    state.paused=false; state.finished=false; state.restart=false
    state.distance=0; state.restarts=state.restarts+1; input.clear(state.input)
    camera.update(state,go.get_position(self.vehicle.body),0,true)
end
function init(self)
    terrain.create(); restart(self)
    self.art=art.create()
    decor(vmath.vector3(terrain.finish,310,0.3),vmath.vector3(5,160,1),vmath.vector4(0.4,1,0.95,1))
    decor(vmath.vector3(terrain.finish+40,380,0.3),vmath.vector3(85,35,1),vmath.vector4(1,0.65,0.3,1))
    window.set_listener(function(_,event)
        if event==window.WINDOW_EVENT_FOCUS_LOST or event==window.WINDOW_EVENT_ICONIFIED then
            state.paused=true; input.clear(state.input)
            vehicle.enable(self.vehicle,false)
        end
    end)
end
function fixed_update(self,dt)
    if state.restart then restart(self) end
    vehicle.enable(self.vehicle,not state.paused and not state.finished)
    if state.paused or state.finished then return end
    local gas,brake=input.pedals(state.input)
    vehicle.step(self.vehicle,state,gas,brake,dt)
    local p=go.get_position(self.vehicle.body)
    state.distance=math.max(0,math.floor((p.x-180)/10))
    if p.x>=terrain.finish then state.finished=true; input.clear(state.input) end
    if p.y<60 then state.paused=true; input.clear(state.input) end
end
function update(self,dt)
    local p=go.get_position(self.vehicle.body)
    camera.update(state,p,dt,false)
    art.update(self.art,state,self.vehicle)
    -- Test harness reads telemetry only; it cannot change simulation state.
    if html5 and html5.run then
        html5.run(string.format('window.moonTelemetry={distance:%d,speed:%.3f,grounded:%s,suspension:%.3f,paused:%s,finished:%s,restarts:%d,airFrames:%d,landings:%d,x:%.3f,y:%.3f,gas:%s,brake:%s,gravity:%.1f,pendingGravity:%.1f,dirty:%s,spin:%.3f};',
            state.distance,state.speed,tostring(state.grounded),state.suspension,tostring(state.paused),tostring(state.finished),state.restarts,state.air_frames,state.landings,p.x,p.y,tostring(select(1,input.pedals(state.input))),tostring(select(2,input.pedals(state.input))),state.settings.gravity,state.pending.gravity,tostring(state.dirty),go.get(msg.url(nil,self.vehicle.body,"co"),"angular_velocity").z))
    end
end
function final(self) window.set_listener(nil) end
