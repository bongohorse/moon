local state=require 'modules.state'
local config=require 'modules.config'
local input=require 'modules.input'
local navy=vmath.vector4(0.063,0.082,0.184,1)
local cyan=vmath.vector4(0.4,0.95,0.92,1)
local cream=vmath.vector4(1,0.9,0.72,1)
local function box(w,h,color)
    local n=gui.new_box_node(vmath.vector3(),vmath.vector3(w,h,0)); gui.set_color(n,color); gui.set_texture(n,'art'); gui.play_flipbook(n,'ui-panel'); gui.set_slice9(n,vmath.vector4(12,12,12,12)); return n
end
local function text(value,scale)
    local n=gui.new_text_node(vmath.vector3(),value); gui.set_font(n,'default')
    gui.set_color(n,cream); gui.set_scale(n,vmath.vector3(scale,scale,1)); return n
end
local function button(self,label,callback,w,h)
    local hit=gui.new_box_node(vmath.vector3(),vmath.vector3(w or 140,h or 55,0)); gui.set_color(hit,vmath.vector4(0,0,0,0))
    local b={hit=hit,node=box(w or 140,h or 55,vmath.vector4(1,1,1,1)),label=text(label,0.8),callback=callback,w=w or 140,h=h or 55}
    self.buttons[#self.buttons+1]=b; return b
end
local function place(b,x,y,s,enabled)
    local width=math.max(b.w*s,b.min_width or 0); local height=math.max(b.h*s,b.min_height or 0)
    gui.set_position(b.hit,vmath.vector3(x,y,0)); gui.set_size(b.hit,vmath.vector3(width,math.max(height,b.hit_height or 0),0))
    gui.set_position(b.node,vmath.vector3(x,y,0)); gui.set_size(b.node,vmath.vector3(b.visual_w and b.visual_w*s or width,b.visual_h and b.visual_h*s or height,0))
    gui.set_position(b.label,vmath.vector3(x,y,0)); gui.set_scale(b.label,vmath.vector3(math.max(.8*s,.54),math.max(.8*s,.54),1))
    gui.set_enabled(b.hit,enabled~=false); gui.set_enabled(b.node,enabled~=false); gui.set_enabled(b.label,enabled~=false)
    if b.icon then
        local icon=math.max(44*s,24)
        gui.set_position(b.icon,vmath.vector3(x-width/2+icon/2+6*s,y,0)); gui.set_size(b.icon,vmath.vector3(icon,icon,0))
        gui.set_position(b.label,vmath.vector3(x+math.max(20*s,15),y,0)); gui.set_scale(b.label,vmath.vector3(math.max(.62*s,.54),math.max(.62*s,.54),1))
        gui.set_enabled(b.icon,enabled~=false)
    end
end
local function pause()
    if state.finished then return end
    state.paused=not state.paused; input.clear(state.input)
end
function init(self)
    msg.post('.','acquire_input_focus')
    self.buttons={}; self.expanded=false
    self.header=box(370,55,vmath.vector4(1,1,1,1))
    self.distance=text('MONDPOST',0.9)
    self.status=text('',1)
    self.gas=button(self,'GAS',nil,240,115)
    self.brake=button(self,'BRAKE',nil,240,115)
    gui.play_flipbook(self.gas.node,'pedal-gas'); gui.play_flipbook(self.brake.node,'pedal-brake')
    gui.set_slice9(self.gas.node,vmath.vector4()); gui.set_slice9(self.brake.node,vmath.vector4())
    gui.set_color(self.gas.label,navy); gui.set_color(self.brake.label,navy)
    self.gas.visual_h=94; self.brake.visual_h=98
    self.pause=button(self,'PAUSE',pause)
    self.restart=button(self,'RESTART',function() state.restart=true end)
    for _,pair in ipairs({{self.pause,'button-pause'},{self.restart,'button-restart'}}) do
        local b=pair[1]; b.icon=gui.new_box_node(vmath.vector3(),vmath.vector3(44,44,0))
        gui.set_texture(b.icon,'art'); gui.play_flipbook(b.icon,pair[2])
    end
    self.dev=button(self,'TUNING +',function() self.expanded=not self.expanded end,160)
    for _,b in ipairs({self.pause,self.restart,self.dev}) do b.min_width=b==self.dev and 100 or 108; b.min_height=40; b.hit_height=44 end
    self.panel=box(1180,270,vmath.vector4(1,1,1,0.96))
    self.rows={}
    for i,spec in ipairs(config.spec) do
        local row={label=text('',0.75)}
        row.minus=button(self,'-',function() config.adjust(state.pending,i,-1); state.dirty=true end,46,30)
        row.plus=button(self,'+',function() config.adjust(state.pending,i,1); state.dirty=true end,46,30)
        self.rows[i]=row
    end
    self.apply=button(self,'APPLY + RESTART',function() state.restart=true end,220,40)
    self.defaults=button(self,'DEFAULTS',function() state.pending=config.defaults(); state.dirty=true end,160,40)
    self.hint=text('Changes apply on restart',0.65)
end
function update(self,dt)
    state.tuning_open=self.expanded
    local w,h=window.get_size(); local safe=window.get_safe_area()
    local scale=math.min(w/1280,h/720)
    local left=math.max(24*scale,safe.inset_left+12*scale)
    local right=w-math.max(24*scale,safe.inset_right+12*scale)
    local top=h-math.max(32*scale,safe.inset_top+20*scale,30)
    local compact=scale<.7
    local bottom=math.max(24*scale,safe.inset_bottom+12*scale)
    place(self.brake,left+120*scale,bottom+57*scale,scale)
    place(self.gas,right-120*scale,bottom+57*scale,scale)
    local control=math.max(140*scale,108); local dev=math.max(160*scale,100)
    local gap=math.max(10*scale,6);local dev_gap=math.max(15*scale,6)
    place(self.pause,right-control/2,top,scale)
    place(self.restart,right-control-gap-control/2,top,scale)
    place(self.dev,right-2*control-gap-dev_gap-dev/2,top,scale)
    gui.set_position(self.header,vmath.vector3(left+185*scale,top,0)); gui.set_size(self.header,vmath.vector3(370*scale,55*scale,0))
    gui.set_position(self.distance,vmath.vector3(left+170*scale,top,0))
    gui.set_scale(self.distance,vmath.vector3(math.max(.8*scale,.54),math.max(.8*scale,.54),1))
    gui.set_text(self.distance,string.format('MONDPOST  /  %03d m',state.distance))
    gui.set_text(self.pause.label,state.paused and 'RESUME' or 'PAUSE')
    local gas,brake=input.pedals(state.input)
    gui.set_color(self.gas.node,gas and vmath.vector4(0.82,0.76,0.68,1) or vmath.vector4(1,1,1,1))
    gui.set_color(self.brake.node,brake and vmath.vector4(0.7,0.78,0.9,1) or vmath.vector4(1,1,1,1))
    for _,pedal in ipairs({self.gas,self.brake}) do
        local pos=gui.get_position(pedal.label); pos.y=pos.y-8*scale
        gui.set_position(pedal.label,pos); gui.set_scale(pedal.label,vmath.vector3(math.max(1.2*scale,.8),math.max(1.2*scale,.8),1))
    end
    gui.set_position(self.status,vmath.vector3(w/2,top-83*scale,0))
    gui.set_text(self.status,state.finished and 'TEST TRACK COMPLETE!  /  RESTART' or (state.paused and 'PAUSED  /  RESUME OR RESTART' or ''))
    gui.set_scale(self.status,vmath.vector3(math.max(.85*scale,.5),math.max(.85*scale,.5),1))
    gui.set_enabled(self.status,not self.expanded)
    gui.set_enabled(self.panel,self.expanded)
    local panel_top=top-math.max(55*scale,40)/2-5*scale
    local panel_height=compact and 180 or 198
    gui.set_position(self.panel,vmath.vector3(w/2,panel_top-panel_height*scale/2,0))
    gui.set_size(self.panel,vmath.vector3(math.min(1180*scale,right-left),panel_height*scale,0))
    for i,row in ipairs(self.rows) do
        local col=i>4 and 1 or 0; local r=(i-1)%4
        local x=w/2+(col==0 and -295 or 285)*scale; local y=panel_top-((compact and 35 or 40)+r*(compact and 29 or 32))*scale
        gui.set_enabled(row.label,self.expanded)
        gui.set_position(row.label,vmath.vector3(x-45*scale,y,0)); gui.set_scale(row.label,vmath.vector3(math.max(.7*scale,.5),math.max(.7*scale,.5),1))
        gui.set_text(row.label,string.format('%s: %.1f',config.spec[i].label,state.pending[config.spec[i].key]))
        row.minus.h=compact and 26 or 30;row.plus.h=row.minus.h
        place(row.minus,x+140*scale,y,scale,self.expanded); place(row.plus,x+195*scale,y,scale,self.expanded)
    end
    self.apply.h=compact and 30 or 32;self.defaults.h=self.apply.h
    place(self.apply,w/2-120*scale,panel_top-(compact and 156 or 171)*scale,scale,self.expanded)
    place(self.defaults,w/2+95*scale,panel_top-(compact and 156 or 171)*scale,scale,self.expanded)
    gui.set_enabled(self.hint,self.expanded)
    gui.set_position(self.hint,vmath.vector3(w/2,panel_top-(compact and 10 or 12)*scale,0))
    gui.set_scale(self.hint,vmath.vector3(math.max(.65*scale,.5),math.max(.65*scale,.5),1))
    gui.set_text(self.hint,state.dirty and 'PENDING CHANGES - APPLY + RESTART REQUIRED' or 'All tuning values apply on restart')
end
local function pointer(self,id,a)
    local x=a.x; local y=a.y
    if a.pressed then
        for _,b in ipairs(self.buttons) do
            if b.callback and gui.is_enabled(b.hit) and gui.pick_node(b.hit,x,y) then b.callback(); return end
        end
    end
    local pedal=nil
    if not state.paused and not state.finished then
        if gui.pick_node(self.gas.hit,x,y) then pedal='gas'
        elseif gui.pick_node(self.brake.hit,x,y) then pedal='brake' end
    end
    input.touch(state.input,id,pedal,a.released)
end
function on_input(self,id,a)
    if id==hash('gas') or id==hash('brake') then
        if a.pressed and not state.paused and not state.finished then state.input.keys[id==hash('gas') and 'gas' or 'brake']=true end
        if a.released then state.input.keys[id==hash('gas') and 'gas' or 'brake']=false end
    elseif id==hash('pause') and a.pressed then pause()
    elseif id==hash('restart') and a.pressed then state.restart=true
    elseif id==hash('multitouch') then
        for _,t in ipairs(a.touch or {}) do pointer(self,t.id,t) end
    elseif id==hash('pointer') then
        if a.pressed then self.mouse_down=true end
        if self.mouse_down or a.released then pointer(self,'mouse',a) end
        if a.released then self.mouse_down=false end
    end
end
