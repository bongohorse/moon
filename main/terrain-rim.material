name: "lunar-rim"
tags: "tile"
vertex_program: "/builtins/materials/sprite.vp"
fragment_program: "/builtins/materials/sprite.fp"
vertex_space: VERTEX_SPACE_WORLD
vertex_constants { name: "view_proj" type: CONSTANT_TYPE_VIEWPROJ }
fragment_constants { name: "tint" type: CONSTANT_TYPE_USER value { x: 0.87 y: 0.84 z: 0.98 w: 1 } }
samplers { name: "texture_sampler" wrap_u: WRAP_MODE_REPEAT wrap_v: WRAP_MODE_REPEAT filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
